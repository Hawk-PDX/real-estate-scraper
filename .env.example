# Database
DATABASE_URL=sqlite:///listings.db

# Proxy Settings
USE_PROXIES=false
PROXY_FILE=config/proxies.txt

# CAPTCHA Solving (optional)
# Get key from 2captcha.com if you need it
CAPTCHA_API_KEY=

# Scraping Behavior
HEADLESS_MODE=false
REQUEST_DELAY_MIN=3
REQUEST_DELAY_MAX=7
MAX_RETRIES=3
REQUESTS_PER_PROXY=50

# Flask API
FLASK_PORT=5000
FLASK_DEBUG=true
